<?xml version="1.0" encoding="utf-8"?>
<!-- Depuis Android 12, le systeme dessine lui-meme l'ecran de lancement : il
     ignore launch_background et impose son icone, petite, au centre. On lui
     laisse le fond de la marque et on efface l'icone : l'ecran est alors
     simplement creme, et notre splash prend la suite sans rupture.

     Les deux themes derivent d'une variante sans barre de titre : sinon
     Android pose une barre blanche portant le nom de l'application. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
