<?xml version="1.0" encoding="utf-8"?>
<!-- Depuis Android 12, le systeme dessine lui-meme l'ecran de lancement :
     il ignore launch_background et affiche l'icone de l'application, petite,
     au centre. On lui donne donc le fond de la marque et le logo en grand,
     pour que le passage a notre splash ne se voie pas. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
